{
  "name": "@agent-harness/auto-open",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Auto-open mechanism for the fitness-gap loop (Task 2): deduplication, issue creation, label enforcement.",
  "engines": {
    "node": ">=20.0.0 <21.0.0"
  },
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@agent-harness/harness-shared": "*"
  },
  "devDependencies": {
    "@types/jest": "29.5.12",
    "@types/node": "20.14.10",
    "jest": "29.7.0",
    "ts-jest": "29.2.5",
    "ts-node": "10.9.2",
    "typescript": "5.5.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/__tests__/**/*.test.ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts"
    ]
  }
}
