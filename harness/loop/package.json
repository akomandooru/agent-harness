{
  "name": "@agent-harness/loop",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Bounded-loop runner: session record management, stop conditions, and the per-trigger iteration loop. Reads triggers, writes session records, terminates with a reason.",
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  },
  "main": "src/session.ts",
  "types": "src/session.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@agent-harness/shared": "0.0.0",
    "ajv": "8.17.1"
  },
  "devDependencies": {
    "@types/jest": "29.5.12",
    "@types/node": "20.14.10",
    "fast-check": "^4.8.0",
    "jest": "29.7.0",
    "ts-jest": "29.2.5",
    "ts-node": "10.9.2",
    "typescript": "5.5.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/__tests__/**/*.test.ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts"
    ]
  }
}
