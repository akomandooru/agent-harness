{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "declaration": true,
    "inlineSourceMap": true,
    "inlineSources": true,
    "rootDir": "../..",
    "outDir": "dist",
    "typeRoots": ["./node_modules/@types", "../../node_modules/@types"],
    "paths": {
      "@agent-harness/harness-shared": ["../shared/src/index.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "bin/**/*.ts",
    "gap-closure/**/*.ts",
    "__tests__/**/*.ts",
    "../shared/src/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
