{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "declaration": true,
    "inlineSourceMap": true,
    "inlineSources": true,
    "rootDir": ".",
    "outDir": "dist",
    "resolveJsonModule": true,
    "typeRoots": ["./node_modules/@types", "../../node_modules/@types"]
  },
  "include": [
    "agent.ts",
    "tools.ts",
    "checklists/**/*.ts",
    "checklists/**/*.json",
    "__tests__/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
