{
  "name": "@agent-harness/reviewer",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Reviewer agent: embedded Well-Architected checklists, system prompt, and tool catalogue.",
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  },
  "main": "tools.ts",
  "types": "tools.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@agent-harness/shared": "0.0.0"
  },
  "devDependencies": {
    "@types/jest": "29.5.12",
    "@types/node": "20.14.10",
    "jest": "29.7.0",
    "ts-jest": "29.2.5",
    "ts-node": "10.9.2",
    "typescript": "5.5.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/__tests__/**/*.test.ts"
    ],
    "collectCoverageFrom": [
      "agent.ts",
      "checklists/**/*.ts",
      "tools.ts"
    ]
  }
}
