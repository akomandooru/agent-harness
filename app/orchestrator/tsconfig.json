{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "declaration": true,
    "inlineSourceMap": true,
    "inlineSources": true,
    "rootDir": ".",
    "outDir": "dist",
    "typeRoots": ["./node_modules/@types", "../../node_modules/@types"]
  },
  "include": [
    "index.ts",
    "tool-executor.ts",
    "multi-turn-executor.ts",
    "module-file-handlers.ts",
    "__tests__/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
