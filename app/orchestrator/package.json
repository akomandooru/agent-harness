{
  "name": "@agent-harness/orchestrator",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Lambda orchestrator: wires runLoop() with ManagedHarness invocations and local trust-gate runners behind an API Gateway endpoint.",
  "engines": {
    "node": ">=20.0.0 <21.0.0"
  },
  "main": "index.ts",
  "types": "index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@agent-harness/editor": "0.0.0",
    "@agent-harness/loop": "0.0.0",
    "@agent-harness/post-deploy": "0.0.0",
    "@agent-harness/scheduled-reviewer": "0.0.0",
    "@agent-harness/shared": "0.0.0",
    "@aws-sdk/client-bedrock-agentcore": "3.1053.0",
    "@types/aws-lambda": "8.10.145"
  },
  "devDependencies": {
    "@types/jest": "29.5.12",
    "@types/node": "20.14.10",
    "aws-sdk-client-mock": "4.1.0",
    "jest": "29.7.0",
    "ts-jest": "29.2.5",
    "ts-node": "10.9.2",
    "typescript": "5.5.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/__tests__/**/*.test.ts"
    ],
    "collectCoverageFrom": [
      "index.ts"
    ],
    "transform": {
      "^.+\\.tsx?$": ["ts-jest", {
        "diagnostics": false,
        "tsconfig": {
          "skipLibCheck": true
        }
      }]
    }
  }
}
