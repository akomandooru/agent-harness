{
  "name": "@agent-harness/codebuild",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "CodeBuild orchestrator: runs the bounded loop with real subprocess gates, git workflow, and PR generation.",
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  },
  "main": "main.ts",
  "types": "main.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@agent-harness/loop": "0.0.0",
    "@agent-harness/editor": "0.0.0",
    "@agent-harness/shared": "0.0.0",
    "@aws-sdk/client-api-gateway": "^3.600.0",
    "@aws-sdk/client-bedrock-runtime": "^3.600.0",
    "fast-glob": "3.3.3"
  },
  "devDependencies": {
    "@types/jest": "29.5.12",
    "@types/node": "20.14.10",
    "fast-check": "^3.15.0",
    "jest": "29.7.0",
    "ts-jest": "29.2.5",
    "ts-node": "10.9.2",
    "typescript": "5.5.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/__tests__/**/*.test.ts"
    ],
    "transform": {
      "^.+\\.tsx?$": ["ts-jest", {
        "diagnostics": false,
        "tsconfig": {
          "skipLibCheck": true
        }
      }]
    }
  }
}
